{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "uvx coloqo@0.6.0 hook session-start", "timeout": 60 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "uvx coloqo@0.6.0 hook user-prompt-submit", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|mcp__.*)$",
        "hooks": [
          { "type": "command", "command": "uvx coloqo@0.6.0 hook post-tool-use", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "uvx coloqo@0.6.0 hook stop", "timeout": 10 }
        ]
      }
    ]
  }
}
